{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACO Mission Control",
  "version": "0.1.0",
  "identifier": "com.benchmark.thesis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACO Mission Control - HACO Adaptive 2-opt Simulator",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": ["icons/icon-32.png", "icons/icon-128.png", "icons/icon-256.png", "icons/icon.ico"]
  }
}
